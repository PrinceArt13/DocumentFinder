{
  "openapi": "3.1.0",
  "info": {
    "title": "Document Search API",
    "description": "Поисковик по текстам документов",
    "version": "1.0.0"
  },
  "paths": {
    "/documents/search": {
      "get": {
        "tags": [
          "documents"
        ],
        "summary": "Поиск документов",
        "description": "Поиск документов по тексту. Возвращает первые 20 документов, упорядоченных по дате создания.",
        "operationId": "search_documents_search_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Текстовый запрос для поиска",
              "title": "Query"
            },
            "description": "Текстовый запрос для поиска"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Document"
                  },
                  "title": "Response Search Documents Search Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/documents/{document_id}": {
      "delete": {
        "tags": [
          "documents"
        ],
        "summary": "Удалить документ",
        "description": "Удалить документ из БД и поискового индекса по ID",
        "operationId": "delete_documents__document_id__delete",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDeleteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "root"
        ],
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Document": {
        "properties": {
          "rubrics": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Rubrics",
            "description": "Массив рубрик"
          },
          "text": {
            "type": "string",
            "title": "Text",
            "description": "Текст документа"
          },
          "created_date": {
            "type": "string",
            "format": "date-time",
            "title": "Created Date",
            "description": "Дата создания документа"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "ID документа"
          }
        },
        "type": "object",
        "required": [
          "rubrics",
          "text",
          "created_date",
          "id"
        ],
        "title": "Document"
      },
      "DocumentDeleteResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "Успешность операции"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Сообщение о результате"
          }
        },
        "type": "object",
        "required": [
          "success",
          "message"
        ],
        "title": "DocumentDeleteResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}